NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Use the same Google OAuth Web Client ID in the frontend and backend.
# Add your local and production origins to Authorized JavaScript origins in Google Cloud.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Resend email delivery (verify your sending domain before production use).
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=CodeMeet <no-reply@your-verified-domain.com>

JUDGE0_API_KEY=your-judge0-api-key
